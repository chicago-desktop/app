# Read from the OS environment on the first start: they create the first
# administrator account. Export them (or copy this file to .env) before the
# first `wippy run`; they are not needed once the account exists.
KICKSIDE_USERS_DEFAULT_ADMIN_EMAIL=admin@example.com
KICKSIDE_USERS_DEFAULT_ADMIN_PASSWORD=change-me

# An operator token for the API (tools/live-update.sh, the desktop command
# channel, the shell's /api/v1/windows/* endpoints). Mint one with an account's
# e-mail and password; it lives 24 hours:
#   curl -s -H 'Content-Type: application/json' -X POST -d '{"email":"…","password":"…"}' http://127.0.0.1:8099/api/public/user/token
KICKSIDE_API_TOKEN=
